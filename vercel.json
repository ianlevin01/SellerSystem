{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.ventaz.com.ar" }],
      "destination": "https://ventaz.com.ar/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/ecom", "destination": "/ecom/index.html" },
    { "source": "/ml", "destination": "/ml/index.html" },
    { "source": "/(.*)", "destination": "/app-shell.html" }
  ],
  "headers": [
    {
      "source": "/(index.html|app-shell.html|ecom/index.html|ml/index.html)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma",        "value": "no-cache" },
        { "key": "Expires",       "value": "0" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
